# Copy to apps/api/.env — full list of variables: docs/external-services.md
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (default: info; silent in tests)
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (used from roadmap step 3: Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shelfwise
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shelfwise
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shelfwise_test
