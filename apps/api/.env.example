# Copy to apps/api/.env — full list of variables: docs/external-services.md
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (default: info; silent in tests)
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (used from roadmap step 3: Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shelfwise
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shelfwise
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shelfwise_test

# Auth (docs/adr/0003). Any 32+ chars locally; Render generates the production value.
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
# Comma-separated origins allowed to send mutating requests (defaults to http://localhost:3000 outside production)
ALLOWED_ORIGINS=http://localhost:3000
# Admin created by `pnpm db:seed:users` (both or neither; password >= 12 chars)
ADMIN_EMAIL=admin@shelfwise.local
ADMIN_PASSWORD=admin-password-local
# Optional: TRUST_PROXY_HOPS=1, AUTH_THROTTLE_PER_MINUTE=10, SIGNUP_THROTTLE_PER_HOUR=5
