{
  "name": "shelfwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "shared:build": "pnpm --filter @shelfwise/shared build",
    "predev": "pnpm shared:build",
    "dev": "pnpm --parallel --recursive --filter=!shelfwise dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm shared:build && pnpm --recursive typecheck",
    "test": "pnpm shared:build && pnpm --recursive test",
    "test:e2e": "pnpm shared:build && pnpm --filter @shelfwise/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "db:generate": "pnpm --filter @shelfwise/api db:generate",
    "db:migrate": "pnpm --filter @shelfwise/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @shelfwise/api db:migrate:deploy",
    "db:studio": "pnpm --filter @shelfwise/api db:studio",
    "db:seed:users": "pnpm --filter @shelfwise/api db:seed:users"
  },
  "devDependencies": {
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}": "prettier --write",
    "apps/web/**/*.{ts,tsx,js,mjs}": "corepack pnpm --filter @shelfwise/web lint",
    "apps/api/**/*.ts": "corepack pnpm --filter @shelfwise/api lint"
  }
}
